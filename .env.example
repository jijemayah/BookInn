# Copy to .env.local (never commit real values).

# --- Database (Supabase Postgres) -------------------------------------------
# Either a full connection string ...
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ... or separate variables:
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
# Optional: PEM of Supabase's root CA to verify the server certificate.
# SUPABASE_DB_CA=

# --- Sessions ----------------------------------------------------------------
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Daily maintenance (Vercel Cron) -------------------------------------------
# At least 16 random characters. Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/maintenance (daily at 00:05 Asia/Manila = "5 16 * * *" UTC), which sets No-Show and emails
# the guest, completes stranded stays, and applies the 1-year retention rule.
CRON_SECRET=

# --- Email (Resend) ----------------------------------------------------------
# Receipts, refund confirmations and No-Show notices are sent through Resend.
# Leave empty in development: emails are then skipped and logged, nothing is sent.
# Create a key at https://resend.com/api-keys. The sender must be on a domain
# verified in Resend, e.g. "BookInn <bookings@your-domain.com>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Seed (optional; random passwords are generated and printed if unset) ----
# To recreate the README mock logins, set these to the passwords listed there.
# SEED_ADMIN_PASSWORD=       # ADMIN (Database Administrator)
# SEED_FRONTDESK_PASSWORD=   # KDPALVARADO (Front Desk)
# SEED_FINANCE_PASSWORD=     # JESMEDEL (Finance)
# SEED_FINANCE2_PASSWORD=    # ETEGGERE (Finance)
