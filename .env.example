# BookInn - Supabase / PostgreSQL connection settings
#
# Copy this file to ".env" (same directory, project root) and fill in
# the real values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> Database -> Connection parameters
#
# Do NOT commit the real ".env" file to version control.

# Host, e.g. db.xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_DB_HOST=

# 5432 = direct connection, 6543 = pooled connection (PgBouncer / Supavisor)
SUPABASE_DB_PORT=5432

# Usually "postgres" unless you created a custom database
SUPABASE_DB_NAME=postgres

# Usually "postgres", or a scoped role you created for this app
SUPABASE_DB_USER=postgres

# The database password set for your Supabase project (NOT the API anon/service key)
SUPABASE_DB_PASSWORD=

# TLS mode for the connection. Supabase requires TLS; "require" is a safe default.
SUPABASE_DB_SSLMODE=require
