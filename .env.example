# Copy to .env.local (never commit real values).

# --- Database (Supabase Postgres) -------------------------------------------
# Either a full connection string ...
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ... or separate variables:
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
# Optional: PEM of Supabase's root CA to verify the server certificate.
# SUPABASE_DB_CA=

# --- Sessions ----------------------------------------------------------------
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Daily maintenance (Vercel Cron) -------------------------------------------
# At least 16 random characters. Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/maintenance, which marks finished stays Completed and applies the 1-year retention rule.
CRON_SECRET=

# --- Seed (optional; random passwords are generated and printed if unset) ----
# SEED_ADMIN_PASSWORD=
# SEED_FRONTDESK_PASSWORD=
# SEED_FINANCE_PASSWORD=
