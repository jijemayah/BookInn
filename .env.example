# BookInn - Supabase / PostgreSQL connection settings
#
# Copy this file to ".env" (same directory, project root) and fill in
# the real values from your Supabase project. Click "Connect" in the
# Supabase dashboard and choose a connection type:
#
#   Direct connection      - for local development
#   Transaction pooler     - for Vercel / serverless (REQUIRED there)
#
# Do NOT commit the real ".env" file to version control.

# Direct:  db.xxxxxxxxxxxxxxxxxxxx.supabase.co
# Pooled:  aws-0-<region>.pooler.supabase.com  (DIFFERENT hostname, not just a port change)
SUPABASE_DB_HOST=

# 5432 = direct connection, 6543 = transaction pooler (Supavisor)
SUPABASE_DB_PORT=5432

# Usually "postgres" unless you created a custom database
SUPABASE_DB_NAME=postgres

# Direct connection: usually "postgres".
# Transaction pooler: "postgres.<project-ref>" (e.g. postgres.ihqfasbxscdlrpamojwv)
# -- the username is DIFFERENT in pooler mode, not just the host/port. Copy the
# exact username shown in the connection string from the "Connect" dialog.
SUPABASE_DB_USER=postgres

# The database password set for your Supabase project (NOT the API anon/service key)
SUPABASE_DB_PASSWORD=

# TLS mode for the connection. Supabase requires TLS; "require" is a safe default.
SUPABASE_DB_SSLMODE=require
