# Copy to .env.local (never commit real values).

# --- Database (Supabase Postgres) -------------------------------------------
# Either a full connection string ...
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ... or the same variables the legacy PHP app uses (the CLI scripts also read ../.env):
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
# Optional: PEM of Supabase's root CA to verify the server certificate.
# SUPABASE_DB_CA=

# --- Sessions ----------------------------------------------------------------
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Seed (optional; random passwords are generated and printed if unset) ----
# SEED_ADMIN_PASSWORD=
# SEED_FRONTDESK_PASSWORD=
# SEED_FINANCE_PASSWORD=
