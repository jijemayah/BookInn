{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.6.2"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/$", "dest": "/api/index.php" },
    { "src": "/login", "dest": "/api/login.php" },
    { "src": "/logout", "dest": "/api/logout.php" },
    { "src": "/dashboard", "dest": "/api/dashboard.php" },
    { "src": "/customers", "dest": "/api/customers.php" },
    { "src": "/rooms", "dest": "/api/rooms.php" },
    { "src": "/reservations", "dest": "/api/reservations.php" },
    { "src": "/payments", "dest": "/api/payments.php" },
    { "src": "/staff", "dest": "/api/staff.php" },
    { "src": "/reports", "dest": "/api/reports.php" }
  ]
}
